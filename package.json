{
  "name": "luyin-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "env:check": "node scripts/check-env.mjs",
    "db:check": "node scripts/check-db.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:live-access": "node scripts/verify-live-access.mjs",
    "format": "prettier --write src tests *.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@langchain/core": "^1.0.0",
    "@langchain/openai": "1.8.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "antd": "6.7.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "langchain": "^1.0.0",
    "next": "16.4.5",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
