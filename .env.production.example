# Configure these in Vercel > Settings > Environment Variables.
# Copy variable names only; supply real values in the dashboard. Never commit secrets.
APP_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Transaction pooler, port 6543, separate restricted database roles.
ERP_READONLY_DATABASE_URL=
APP_DATABASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# API origin only, without /mcp/ or /v1/documents.
ONTORAG_BASE_URL=
ONTORAG_SERVICE_API_KEY=
